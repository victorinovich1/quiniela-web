NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# ============================================================
# Cron Jobs & API Sync (OBLIGATORIO para sincronización automática)
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY: Clave con privilegios de servicio.
# Requerida para /api/cron/sync-results y /api/cron/check-reminders.
# Obtén esta clave desde Supabase Dashboard > Settings > API.
# NUNCA expongas esta clave en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET: Token secreto para autenticar llamadas desde Vercel Cron.
# Genera un UUID o string aleatorio fuerte. Configura el mismo valor
# en Vercel Environment Variables.
CRON_SECRET=

# ============================================================
# Football Data API (Opcional - para sincronización de resultados)
# ============================================================
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITION_CODE=WC
FOOTBALL_DATA_SEASON=2026

# ============================================================
# Web Push Notifications (Opcional)
# ============================================================
# VAPID_PRIVATE_KEY: Clave privada VAPID para notificaciones push.
# Genera con: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_KEY=

# Email de contacto para VAPID (opcional)
# Si no se define, usa: mailto:admin@quinielamundial.com
VAPID_CONTACT_EMAIL=
